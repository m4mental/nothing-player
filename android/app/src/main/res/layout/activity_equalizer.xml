<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nothing_black"
    android:padding="14dp">

    <!-- Header (No Clipping, Snug Top) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btn_back_eq"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/nothing_white"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_eq"
            android:layout_toStartOf="@id/header_actions"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/eq_power_led"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/led_red"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_eq_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EQUALIZER (DSP)"
                    android:textColor="@color/nothing_white"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_eq_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5-BAND GRAPHIC + SURROUND"
                android:textColor="@color/nothing_white_40"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- Right Side: Power Switch & Reset Button -->
        <LinearLayout
            android:id="@+id/header_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_eq_power"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_selected"
                android:text="ON"
                android:textColor="@color/nothing_black"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_reset_eq"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="RESET"
                android:textColor="@color/nothing_white_70"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Preset Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginVertical="8dp">

        <LinearLayout
            android:id="@+id/eq_preset_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/preset_nothing_punch"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip_selected"
                android:text="NOTHING PUNCH"
                android:textColor="@color/nothing_black"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp" />

            <TextView
                android:id="@+id/preset_cinema"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="CINEMA (3D THEATER)"
                android:textColor="@color/nothing_white_70"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp" />

            <TextView
                android:id="@+id/preset_bass_boost"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="BASS BOOST"
                android:textColor="@color/nothing_white_70"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp" />

            <TextView
                android:id="@+id/preset_edm"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="EDM"
                android:textColor="@color/nothing_white_70"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp" />

            <TextView
                android:id="@+id/preset_rock"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="ROCK"
                android:textColor="@color/nothing_white_70"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp" />

            <TextView
                android:id="@+id/preset_pop"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="POP"
                android:textColor="@color/nothing_white_70"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp" />

            <TextView
                android:id="@+id/preset_vocal"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="VOCAL"
                android:textColor="@color/nothing_white_70"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp" />

            <TextView
                android:id="@+id/preset_flat"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="FLAT"
                android:textColor="@color/nothing_white_70"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="12dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Equalizer Scroll Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 5-Band Graphic Equalizer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_nothing"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GRAPHIC EQUALIZER (5-BAND)"
                    android:textColor="@color/nothing_white"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="10dp" />

                <!-- Band 1: 60 Hz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:text="60 Hz"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seekbar_band_0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="30"
                        android:progress="15" />
                    <TextView
                        android:id="@+id/tv_band_0_val"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Band 2: 230 Hz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:text="230 Hz"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seekbar_band_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="30"
                        android:progress="15" />
                    <TextView
                        android:id="@+id/tv_band_1_val"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Band 3: 910 Hz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:text="910 Hz"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seekbar_band_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="30"
                        android:progress="15" />
                    <TextView
                        android:id="@+id/tv_band_2_val"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Band 4: 3.6 kHz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:text="3.6 kHz"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seekbar_band_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="30"
                        android:progress="15" />
                    <TextView
                        android:id="@+id/tv_band_3_val"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Band 5: 14 kHz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:text="14 kHz"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seekbar_band_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="30"
                        android:progress="15" />
                    <TextView
                        android:id="@+id/tv_band_4_val"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- DSP Audio Enhancements Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_nothing"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOUND FX &amp; SPATIAL AUDIO"
                    android:textColor="@color/nothing_white"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="10dp" />

                <!-- Bass Boost Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:text="BASS BOOST"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seekbar_bass_boost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="100"
                        android:progress="60" />
                    <TextView
                        android:id="@+id/tv_bass_boost_val"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="60%"
                        android:textColor="@color/nothing_white"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </LinearLayout>

                <!-- 3D Virtualizer / Spatial Sound -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:text="3D SURROUND"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seekbar_virtualizer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="100"
                        android:progress="50" />
                    <TextView
                        android:id="@+id/tv_virtualizer_val"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="50%"
                        android:textColor="@color/nothing_white"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Preamp Master Gain -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:text="PREAMP GAIN"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />
                    <SeekBar
                        android:id="@+id/seekbar_preamp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="24"
                        android:progress="12" />
                    <TextView
                        android:id="@+id/tv_preamp_val"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
