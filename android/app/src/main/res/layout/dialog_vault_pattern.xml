<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_nothing"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/led_red"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DRAW VAULT PATTERN"
            android:textColor="@color/nothing_white"
            android:textSize="13sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect dots to authorize action:"
        android:textColor="@color/nothing_white_70"
        android:textSize="8.5sp"
        android:fontFamily="@font/ndot"
        android:layout_marginBottom="12dp" />

    <com.nothing.player.DotMatrixPatternView
        android:id="@+id/pv_dialog_pattern"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_dialog_pattern_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INCORRECT PATTERN. TRY AGAIN"
        android:textColor="@color/nothing_red"
        android:textSize="8.5sp"
        android:fontFamily="@font/ndot"
        android:visibility="gone"
        android:layout_marginBottom="10dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_pattern_cancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_unselected"
            app:backgroundTint="@null"
            android:text="CANCEL"
            android:textColor="@color/nothing_white_70"
            android:textSize="8sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

</LinearLayout>

