<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nothing_black"
    android:paddingHorizontal="14dp">

    <!-- Contextual Selection Action Bar -->
    <RelativeLayout
        android:id="@+id/music_selection_action_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_selection_bar"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_close_music_selection"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/nothing_white"
            android:contentDescription="Close Selection" />

        <TextView
            android:id="@+id/tv_music_selection_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_close_music_selection"
            android:layout_toStartOf="@id/music_selection_action_buttons"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:text="1 selected"
            android:textColor="@color/nothing_white"
            android:textSize="12sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/music_selection_action_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_music_select_all"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="ALL"
                android:textColor="@color/nothing_white_70"
                android:textSize="10sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_music_delete_selected"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip_selected"
                android:text="DELETE"
                android:textColor="@color/nothing_black"
                android:textSize="10sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:paddingHorizontal="10dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Search Box -->
    <EditText
        android:id="@+id/et_search_music"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_chip_unselected"
        android:hint="Search tracks, artists, albums..."
        android:textColorHint="@color/nothing_white_40"
        android:textColor="@color/nothing_white"
        android:textSize="12sp"
        android:fontFamily="@font/ndot"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:layout_marginBottom="10dp" />

    <!-- Music Sub-filter Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/chip_music_tracks"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_selected"
            android:text="TRACKS"
            android:textColor="@color/nothing_black"
            android:textSize="11sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <TextView
            android:id="@+id/chip_music_artists"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="ARTISTS"
            android:textColor="@color/nothing_white_70"
            android:textSize="11sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <TextView
            android:id="@+id/chip_music_favorites"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="FAVORITES"
            android:textColor="@color/nothing_white_70"
            android:textSize="11sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_music"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
