<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nothing_black"
    android:paddingHorizontal="14dp"
    android:paddingTop="6dp">

    <!-- Contextual Selection Action Bar -->
    <RelativeLayout
        android:id="@+id/selection_action_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_selection_bar"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_close_selection"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/nothing_white"
            android:contentDescription="Close Selection" />

        <TextView
            android:id="@+id/tv_selection_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_close_selection"
            android:layout_toStartOf="@id/selection_action_buttons"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:text="1 selected"
            android:textColor="@color/nothing_white"
            android:textSize="10sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/selection_action_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_select_all"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip_unselected"
                app:backgroundTint="@null"
                android:text="ALL"
                android:textColor="@color/nothing_white"
                android:textSize="8.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_vault_selected"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip_unselected"
                app:backgroundTint="@null"
                android:text="VAULT"
                android:textColor="@color/nothing_white"
                android:textSize="8.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_trash_selected"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip_unselected"
                app:backgroundTint="@null"
                android:text="TRASH"
                android:textColor="@color/nothing_white"
                android:textSize="8.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_delete_selected"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip_delete"
                app:backgroundTint="@null"
                android:text="DELETE"
                android:textColor="#FFFFFF"
                android:textSize="8.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:paddingHorizontal="14dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Search & Filter Controls -->
    <LinearLayout
        android:id="@+id/search_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/et_search_videos"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:hint="Search videos, movies, clips..."
            android:textColorHint="@color/nothing_white_40"
            android:textColor="@color/nothing_white"
            android:textSize="10.5sp"
            android:fontFamily="@font/ndot"
            android:paddingHorizontal="14dp"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btn_videos_overflow_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="More Options"
            app:tint="@color/nothing_white" />
    </LinearLayout>

    <!-- Category Tabs Chips directly below search bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_folders"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_selected"
                android:text="FOLDERS"
                android:textColor="@color/nothing_black"
                android:textSize="9.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="16dp" />

            <TextView
                android:id="@+id/chip_series"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="WEB SERIES"
                android:textColor="@color/nothing_white_70"
                android:textSize="9.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="16dp" />

            <TextView
                android:id="@+id/chip_movies"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="MOVIES"
                android:textColor="@color/nothing_white_70"
                android:textSize="9.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="16dp" />

            <TextView
                android:id="@+id/chip_all_videos"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="ALL VIDEOS"
                android:textColor="@color/nothing_white_70"
                android:textSize="9.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="16dp" />

            <TextView
                android:id="@+id/chip_network_stream"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="ONLINE STREAM"
                android:textColor="@color/nothing_white_70"
                android:textSize="9.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="14dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Smart Continue Watching Series Hub -->
    <LinearLayout
        android:id="@+id/section_continue_series"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_nothing"
        android:padding="12dp"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/led_red"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTINUE WATCHING"
                    android:textColor="#D71921"
                    android:textSize="8.5sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_continue_series_time_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="14 MIN LEFT"
                android:textColor="@color/nothing_white_70"
                android:textSize="8sp"
                android:fontFamily="@font/ndot" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/iv_continue_series_thumb"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_card_nothing" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/iv_continue_series_thumb"
                android:layout_toStartOf="@id/btn_continue_series_resume"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_continue_series_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SERIES TITLE"
                    android:textColor="@color/nothing_white"
                    android:textSize="11sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tv_continue_series_episode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EP 02 • S01"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8.5sp"
                    android:fontFamily="@font/ndot"
                    android:singleLine="true"
                    android:layout_marginTop="2dp" />

                <com.nothing.player.DotMatrixProgressBar
                    android:id="@+id/pb_continue_series_progress"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_continue_series_resume"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_chip_red_active"
                android:text="RESUME"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:paddingHorizontal="14dp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Horizontal Watch History Carousel Section -->
    <LinearLayout
        android:id="@+id/section_history_carousel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <!-- History Section Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="● RECENTLY WATCHED"
                android:textColor="@color/nothing_white"
                android:textSize="9.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_open_history_sheet"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_chip_unselected"
                app:backgroundTint="@null"
                android:text="HISTORY ⊞"
                android:textColor="@color/nothing_white"
                android:textSize="8sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:paddingHorizontal="10dp" />
        </RelativeLayout>

        <!-- Horizontal History RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_history_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- Swipe Refresh & Recycler -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_videos"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
