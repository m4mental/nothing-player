<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_card_nothing"
    android:padding="10dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/track_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:background="@color/nothing_surface"
        android:src="@android:drawable/ic_lock_silent_mode_off" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/track_art"
        android:layout_toStartOf="@id/track_actions"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Track Title"
            android:textColor="@color/nothing_white"
            android:textSize="12sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/track_artist_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Artist • Album • MP3"
            android:textColor="@color/nothing_white_40"
            android:textSize="10sp"
            android:fontFamily="@font/ndot"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/track_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/track_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03:45"
            android:textColor="@color/nothing_white_40"
            android:textSize="10sp"
            android:fontFamily="@font/ndot"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btn_track_menu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            android:contentDescription="Options"
            app:tint="@color/nothing_white_40" />

        <!-- Selection Check Indicator -->
        <ImageView
            android:id="@+id/selection_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</RelativeLayout>
