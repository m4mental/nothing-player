<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card_nothing"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/folder_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_circle_button"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_agenda"
        app:tint="@color/nothing_red" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/folder_icon"
        android:layout_toStartOf="@id/folder_arrow"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/folder_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movies / Download"
            android:textColor="@color/nothing_white"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/folder_video_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="14 Videos"
            android:textColor="@color/nothing_white_40"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <ImageView
        android:id="@+id/selection_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone" />

    <TextView
        android:id="@+id/folder_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="›"
        android:textColor="@color/nothing_white_40"
        android:textSize="18sp"
        android:fontFamily="monospace" />

</RelativeLayout>
