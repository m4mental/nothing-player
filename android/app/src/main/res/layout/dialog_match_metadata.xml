<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_nothing"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/led_red"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MATCH SHOW / MOVIE INFO"
            android:textColor="#D71921"
            android:textSize="9sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT CATEGORY:"
        android:textColor="@color/nothing_white_40"
        android:textSize="7.5sp"
        android:fontFamily="@font/ndot"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_type_series"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selected"
            android:text="WEB SERIES"
            android:textColor="@color/nothing_black"
            android:textSize="8.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_type_movie"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:text="MOVIE"
            android:textColor="@color/nothing_white"
            android:textSize="8.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TITLE OR SHOW NAME:"
        android:textColor="@color/nothing_white_40"
        android:textSize="7.5sp"
        android:fontFamily="@font/ndot"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/et_match_query"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_chip_unselected"
        android:hint="Enter show or movie title..."
        android:textColorHint="@color/nothing_white_40"
        android:textColor="@color/nothing_white"
        android:textSize="10.5sp"
        android:fontFamily="@font/ndot"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:layout_marginBottom="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_match_cancel"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="CANCEL"
            android:textColor="@color/nothing_white"
            android:textSize="8.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_match_search"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_chip_red_active"
            android:text="SEARCH &amp; MATCH"
            android:textColor="#FFFFFF"
            android:textSize="8.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="18dp" />
    </LinearLayout>

</LinearLayout>
