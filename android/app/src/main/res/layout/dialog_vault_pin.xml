<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_nothing"
    android:padding="20dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/led_red"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_dialog_pin_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIVATE VAULT PIN"
            android:textColor="@color/nothing_white"
            android:textSize="13sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_dialog_pin_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter 4-digit security PIN:"
        android:textColor="@color/nothing_white_70"
        android:textSize="8.5sp"
        android:fontFamily="@font/ndot"
        android:layout_marginBottom="14dp" />

    <!-- PIN Input Field -->
    <EditText
        android:id="@+id/et_dialog_pin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_chip_unselected"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:gravity="center"
        android:textColor="@color/nothing_white"
        android:textColorHint="@color/nothing_white_40"
        android:textSize="18sp"
        android:letterSpacing="0.3"
        android:fontFamily="@font/ndot"
        android:hint="••••"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="18dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_pin_cancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_unselected"
            app:backgroundTint="@null"
            android:text="CANCEL"
            android:textColor="@color/nothing_white_70"
            android:textSize="8sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_pin_confirm"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_red"
            app:backgroundTint="@null"
            android:text="CONFIRM"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

</LinearLayout>

