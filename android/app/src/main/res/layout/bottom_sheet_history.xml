<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nothing_black"
    android:padding="16dp">

    <!-- Top Grab Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="● WATCH HISTORY"
            android:textColor="@color/nothing_white"
            android:textSize="16sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_clear_history"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip_delete"
            app:backgroundTint="@null"
            android:text="CLEAR ALL"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="14dp" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Resume playback from where you left off or start over"
        android:textColor="@color/nothing_white_40"
        android:textSize="10sp"
        android:fontFamily="@font/ndot" />

    <!-- Separator Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_history"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_folder_recent"
            app:tint="@color/nothing_white_40"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO WATCH HISTORY"
            android:textColor="@color/nothing_white_70"
            android:textSize="13sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Videos you watch will appear here"
            android:textColor="@color/nothing_white_40"
            android:textSize="10sp"
            android:fontFamily="@font/ndot" />
    </LinearLayout>

    <!-- History List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_history_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:overScrollMode="never" />

</LinearLayout>
