<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nothing_black"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- 10-Band DSP Equalizer Card -->
        <RelativeLayout
            android:id="@+id/card_open_equalizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_nothing"
            android:padding="16dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/eq_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_button"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/nothing_red" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/eq_icon"
                android:layout_toStartOf="@id/eq_arrow"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10-Band DSP Equalizer"
                    android:textColor="@color/nothing_white"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Bass punch, Preamp &amp; Nothing acoustic presets"
                    android:textColor="@color/nothing_white_40"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <TextView
                android:id="@+id/eq_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="›"
                android:textColor="@color/nothing_white_40"
                android:textSize="20sp"
                android:fontFamily="monospace" />
        </RelativeLayout>

        <!-- Hardware Acceleration (HW+) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_nothing"
            android:padding="16dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/hw_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_button"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/nothing_red" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/hw_icon"
                android:layout_toStartOf="@id/hw_badge"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hardware Acceleration (HW+)"
                    android:textColor="@color/nothing_white"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="GPU hardware decoding for 4K / 60FPS"
                    android:textColor="@color/nothing_white_40"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <TextView
                android:id="@+id/hw_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="#22D71921"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="ACTIVE (HW)"
                android:textColor="@color/nothing_red"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Audio Boost 200% Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_nothing"
            android:padding="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MX Audio Boost Limit"
                    android:textColor="@color/nothing_white"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_audio_boost_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="150%"
                    android:textColor="@color/nothing_red"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Overdrive volume up to 200% with clipping protection"
                android:textColor="@color/nothing_white_40"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekbar_audio_boost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/nothing_red"
                android:thumbTint="@color/nothing_white" />
        </LinearLayout>

        <!-- About Nothing Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nothing_surface"
            android:padding="20dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTHING PLAYER (01)"
                android:textColor="@color/nothing_white"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="100% PURE NATIVE ANDROID ARCHITECTURE"
                android:textColor="@color/nothing_white_40"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Engineered for Nothing Phone (2a) &amp; all Android Devices"
                android:textColor="@color/nothing_white_40"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
