<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="6dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Timestamp Pill -->
    <TextView
        android:id="@+id/tv_dialogue_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:34"
        android:textColor="#D71921"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:fontFamily="@font/ndot"
        android:background="@drawable/bg_chip_dark_inactive"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginEnd="12dp" />

    <!-- Dialogue Text -->
    <TextView
        android:id="@+id/tv_dialogue_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Sample dialogue text from subtitle"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:fontFamily="@font/ndot"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Word Lookup Button -->
    <ImageButton
        android:id="@+id/btn_dialogue_dict"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_subtitles"
        app:tint="#88FFFFFF"
        android:layout_marginStart="8dp"
        android:contentDescription="Word Lookup &amp; Translation" />

</LinearLayout>

