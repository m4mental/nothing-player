<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_nothing"
    android:padding="20dp"
    android:minWidth="320dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● "
            android:textColor="#D71921"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_nothing_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DIALOG TITLE"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/ndot"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26FFFFFF"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp" />

    <!-- Scrollable Message Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="320dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tv_nothing_dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Message body goes here..."
            android:textColor="#DDFFFFFF"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.3"
            android:fontFamily="@font/ndot" />
    </ScrollView>

    <!-- Close Action -->
    <Button
        android:id="@+id/btn_nothing_dialog_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="CLOSE"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/ndot"
        android:background="@drawable/bg_chip_red_active" />

</LinearLayout>
