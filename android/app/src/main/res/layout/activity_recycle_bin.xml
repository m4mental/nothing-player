<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nothing_black">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/trash_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="14dp"
        android:background="@color/nothing_black">

        <ImageButton
            android:id="@+id/btn_back_trash"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            app:tint="@color/nothing_white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_trash"
            android:layout_toStartOf="@id/btn_empty_trash"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/led_red"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_trash_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECYCLE BIN"
                    android:textColor="@color/nothing_white"
                    android:textSize="13sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_trash_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAFE RECOVERY • 30 DAYS"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_empty_trash"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip_delete"
            app:backgroundTint="@null"
            android:text="EMPTY BIN"
            android:textColor="#FFFFFF"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="10dp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- Main Container: Empty state OR Recycle Bin List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_trash_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/nothing_white_40"
                android:layout_marginBottom="16dp"
                android:contentDescription="Empty Recycle Bin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECYCLE BIN IS EMPTY"
                android:textColor="@color/nothing_white"
                android:textSize="13sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deleted videos are safely kept here for 30 days before permanent deletion."
                android:textColor="@color/nothing_white_70"
                android:textSize="9.5sp"
                android:fontFamily="@font/ndot"
                android:gravity="center" />
        </LinearLayout>

        <!-- Trashed Videos RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_trash_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

    </FrameLayout>

</LinearLayout>

