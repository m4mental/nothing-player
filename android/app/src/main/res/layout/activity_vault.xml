<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nothing_black">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/top_bar_vault"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        android:background="@color/nothing_black">

        <ImageButton
            android:id="@+id/btn_back_vault"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_dotmatrix"
            android:contentDescription="Back"
            app:tint="@color/nothing_white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_vault"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/vault_red_led"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/led_red"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_vault_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRIVATE VAULT"
                    android:textColor="@color/nothing_white"
                    android:textSize="13sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_vault_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENCRYPTED VIDEO LOCKER"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_vault_config"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip_unselected"
            app:backgroundTint="@null"
            android:text="⚙️ SECURITY"
            android:textColor="@color/nothing_white_70"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="10dp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- Main Container: Either Lock Screen OR Vault Contents -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Authentication Lock Screen (Supports PIN, Pattern & Biometrics) -->
        <ScrollView
            android:id="@+id/layout_vault_lock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp">

                <ImageView
                    android:id="@+id/iv_vault_lock_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_lock_closed"
                    app:tint="@color/nothing_red"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="Vault Lock" />

                <TextView
                    android:id="@+id/tv_pin_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNLOCK PRIVATE VAULT"
                    android:textColor="@color/nothing_white"
                    android:textSize="15sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_pin_subheading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Authenticate to access protected private videos"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8.5sp"
                    android:fontFamily="@font/ndot"
                    android:gravity="center"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tv_pin_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INCORRECT PASSCODE. TRY AGAIN"
                    android:textColor="@color/nothing_red"
                    android:textSize="8.5sp"
                    android:fontFamily="@font/ndot"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp" />

                <!-- A. PIN Mode Container -->
                <LinearLayout
                    android:id="@+id/container_pin_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- 4 Dot-Matrix LED Indicators -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <View
                            android:id="@+id/pin_dot_1"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/led_inactive"
                            android:layout_marginHorizontal="8dp" />

                        <View
                            android:id="@+id/pin_dot_2"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/led_inactive"
                            android:layout_marginHorizontal="8dp" />

                        <View
                            android:id="@+id/pin_dot_3"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/led_inactive"
                            android:layout_marginHorizontal="8dp" />

                        <View
                            android:id="@+id/pin_dot_4"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/led_inactive"
                            android:layout_marginHorizontal="8dp" />
                    </LinearLayout>

                    <!-- PIN Input -->
                    <EditText
                        android:id="@+id/et_vault_pin_input"
                        android:layout_width="220dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:inputType="numberPassword"
                        android:maxLength="4"
                        android:gravity="center"
                        android:textColor="@color/nothing_white"
                        android:textColorHint="@color/nothing_white_40"
                        android:textSize="20sp"
                        android:letterSpacing="0.4"
                        android:fontFamily="@font/ndot"
                        android:hint="••••"
                        android:layout_marginBottom="12dp" />

                    <!-- PIN Submit Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_submit_vault_pin"
                        android:layout_width="220dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_button_red"
                        app:backgroundTint="@null"
                        android:text="UNLOCK VAULT"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/ndot"
                        android:textStyle="bold"
                        android:elevation="4dp" />
                </LinearLayout>

                <!-- B. Pattern Mode Container -->
                <LinearLayout
                    android:id="@+id/container_pattern_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <com.nothing.player.DotMatrixPatternView
                        android:id="@+id/pattern_view_vault"
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tv_pattern_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONNECT AT LEAST 4 DOTS"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="8sp"
                        android:fontFamily="@font/ndot"
                        android:layout_marginBottom="12dp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_submit_vault_pattern"
                        android:layout_width="220dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_button_red"
                        app:backgroundTint="@null"
                        android:text="CONFIRM PATTERN"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/ndot"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:elevation="4dp" />
                </LinearLayout>

                <!-- C. Biometric Quick Unlock (Fingerprint & Face) -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_vault_biometric_quick"
                    android:layout_width="240dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip_unselected"
                    app:backgroundTint="@null"
                    android:text="🔘 FINGERPRINT / FACE UNLOCK"
                    android:textColor="@color/nothing_white"
                    android:textSize="8.5sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <!-- D. Switch Auth Method Button -->
                <TextView
                    android:id="@+id/tv_switch_auth_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SWITCH TO PATTERN UNLOCK"
                    android:textColor="@color/nothing_red"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:padding="10dp"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>
        </ScrollView>

        <!-- 2. Unlocked Vault Videos Content -->
        <FrameLayout
            android:id="@+id/layout_vault_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Empty Vault State -->
            <LinearLayout
                android:id="@+id/layout_vault_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_lock_closed"
                    app:tint="@color/nothing_red"
                    android:alpha="0.4"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Empty Vault" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VAULT IS EMPTY"
                    android:textColor="@color/nothing_white"
                    android:textSize="13sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT VIDEOS IN LIBRARY AND TAP 'MOVE TO VAULT' TO ENCRYPT &amp; HIDE THEM FROM STORAGE"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Vault Videos List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_vault_videos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="24dp" />

        </FrameLayout>

    </FrameLayout>

</LinearLayout>
