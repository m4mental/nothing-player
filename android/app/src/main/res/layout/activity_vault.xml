<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nothing_black">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/vault_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="14dp"
        android:background="@color/nothing_black">

        <ImageButton
            android:id="@+id/btn_back_vault"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            app:tint="@color/nothing_white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_back_vault"
            android:layout_toStartOf="@id/btn_vault_change_pin"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/vault_red_led"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/led_red"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_vault_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRIVATE VAULT"
                    android:textColor="@color/nothing_white"
                    android:textSize="13sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_vault_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENCRYPTED VIDEO LOCKER"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_vault_change_pin"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip_unselected"
            app:backgroundTint="@null"
            android:text="CHANGE PIN"
            android:textColor="@color/nothing_white_70"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:visibility="gone" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- Main Container: Either PIN Lock Screen OR Vault Contents -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. PIN Lock / Setup Screen -->
        <LinearLayout
            android:id="@+id/layout_vault_lock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp">

            <ImageView
                android:id="@+id/iv_vault_lock_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_lock_closed"
                app:tint="@color/nothing_red"
                android:layout_marginBottom="16dp"
                android:contentDescription="Vault Lock" />

            <TextView
                android:id="@+id/tv_pin_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SET 4-DIGIT PIN"
                android:textColor="@color/nothing_white"
                android:textSize="16sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_pin_subheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a security PIN to protect your private videos"
                android:textColor="@color/nothing_white_70"
                android:textSize="9.5sp"
                android:fontFamily="@font/ndot"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- 4 Dot-Matrix LED Indicators -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <View
                    android:id="@+id/pin_dot_1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/led_inactive"
                    android:layout_marginHorizontal="8dp" />

                <View
                    android:id="@+id/pin_dot_2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/led_inactive"
                    android:layout_marginHorizontal="8dp" />

                <View
                    android:id="@+id/pin_dot_3"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/led_inactive"
                    android:layout_marginHorizontal="8dp" />

                <View
                    android:id="@+id/pin_dot_4"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/led_inactive"
                    android:layout_marginHorizontal="8dp" />
            </LinearLayout>

            <!-- High-Contrast PIN Input -->
            <EditText
                android:id="@+id/et_vault_pin_input"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip_unselected"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:gravity="center"
                android:textColor="@color/nothing_white"
                android:textColorHint="@color/nothing_white_40"
                android:textSize="20sp"
                android:letterSpacing="0.4"
                android:fontFamily="@font/ndot"
                android:hint="••••"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_pin_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INCORRECT PIN. TRY AGAIN"
                android:textColor="@color/nothing_red"
                android:textSize="9sp"
                android:fontFamily="@font/ndot"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Prominent High-Contrast Setup / Confirm Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_submit_vault_pin"
                android:layout_width="220dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_button_red"
                app:backgroundTint="@null"
                android:text="CONFIRM &amp; SET PIN"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:elevation="4dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- 2. Unlocked Vault Videos Content -->
        <FrameLayout
            android:id="@+id/layout_vault_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Empty Vault State -->
            <LinearLayout
                android:id="@+id/layout_vault_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_lock_open"
                    app:tint="@color/nothing_white_40"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Empty Vault" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VAULT IS EMPTY"
                    android:textColor="@color/nothing_white"
                    android:textSize="13sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select videos on the home page and tap [VAULT] to hide them here."
                    android:textColor="@color/nothing_white_70"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/ndot"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Vault Videos Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_vault_videos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

        </FrameLayout>

    </FrameLayout>

</LinearLayout>

