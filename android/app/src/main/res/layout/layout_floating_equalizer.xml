<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/window_floating_equalizer"
    android:layout_width="325dp"
    android:layout_height="wrap_content"
    android:layout_gravity="end|center_vertical"
    android:layout_marginEnd="16dp"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_window"
    android:elevation="32dp"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    android:padding="12dp">

    <!-- Top Drag Bar & Header -->
    <LinearLayout
        android:id="@+id/eq_drag_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Visual Drag Handle Pill (Large Touch Target) -->
        <FrameLayout
            android:id="@+id/layout_drag_handle_bar"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginBottom="2dp">
            <View
                android:id="@+id/eq_drag_pill"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_sheet_handle" />
        </FrameLayout>

        <!-- Header Actions Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <!-- Title & LED -->
            <LinearLayout
                android:id="@+id/eq_title_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/float_eq_power_led"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/led_red"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_float_eq_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EQUALIZER"
                    android:textColor="@color/nothing_white"
                    android:textSize="11sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <!-- Right Controls: Power Switch, Reset, Minimize, Close -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_float_eq_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ON"
                    android:textColor="@color/nothing_white"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color"
                    android:checked="true"
                    android:layout_marginEnd="6dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_float_eq_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_chip_unselected"
                    app:backgroundTint="@null"
                    android:text="RESET"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="7sp"
                    android:fontFamily="@font/ndot"
                    android:paddingHorizontal="6dp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/btn_minimize_float_eq"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_collapse"
                    app:tint="@color/nothing_white_70"
                    android:contentDescription="Minimize"
                    android:layout_marginEnd="4dp" />

                <ImageButton
                    android:id="@+id/btn_close_float_eq"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close_dotmatrix"
                    app:tint="@color/nothing_white"
                    android:contentDescription="Close" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Main Content Body (Can be collapsed / minimized) -->
    <LinearLayout
        android:id="@+id/eq_body_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Presets Horizontal Carousel -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/preset_float_punch"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_chip_selected"
                    android:text="NOTHING PUNCH"
                    android:textColor="@color/nothing_black"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="8dp" />

                <TextView
                    android:id="@+id/preset_float_cinema"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="CINEMA 3D"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="8dp" />

                <TextView
                    android:id="@+id/preset_float_bass"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="BASS BOOST"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="8dp" />

                <TextView
                    android:id="@+id/preset_float_edm"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="EDM"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="8dp" />

                <TextView
                    android:id="@+id/preset_float_rock"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="ROCK"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="8dp" />

                <TextView
                    android:id="@+id/preset_float_pop"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="POP"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="8dp" />

                <TextView
                    android:id="@+id/preset_float_vocal"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="VOCAL"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="8dp" />

                <TextView
                    android:id="@+id/preset_float_flat"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="FLAT"
                    android:textColor="@color/nothing_white_70"
                    android:textSize="8sp"
                    android:fontFamily="@font/ndot"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Sliders Scroll Area -->
        <ScrollView
            android:id="@+id/eq_sliders_scroll"
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 5-Band Sliders -->
                <!-- Band 0: 60 Hz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="60 HZ"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot" />
                    <SeekBar
                        android:id="@+id/seekbar_float_band_0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="30"
                        android:progress="15" />
                    <TextView
                        android:id="@+id/tv_float_band_0_val"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Band 1: 230 Hz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="230 HZ"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot" />
                    <SeekBar
                        android:id="@+id/seekbar_float_band_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="30"
                        android:progress="15" />
                    <TextView
                        android:id="@+id/tv_float_band_1_val"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Band 2: 910 Hz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="910 HZ"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot" />
                    <SeekBar
                        android:id="@+id/seekbar_float_band_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="30"
                        android:progress="15" />
                    <TextView
                        android:id="@+id/tv_float_band_2_val"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Band 3: 3.6 kHz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="3.6 KHZ"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot" />
                    <SeekBar
                        android:id="@+id/seekbar_float_band_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="30"
                        android:progress="15" />
                    <TextView
                        android:id="@+id/tv_float_band_3_val"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Band 4: 14 kHz -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="14 KHZ"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot" />
                    <SeekBar
                        android:id="@+id/seekbar_float_band_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="30"
                        android:progress="15" />
                    <TextView
                        android:id="@+id/tv_float_band_4_val"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#26FFFFFF"
                    android:layout_marginVertical="6dp" />

                <!-- DSP Enhancers: Bass Boost, 3D Surround, Preamp -->
                <!-- Bass Boost -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="BASS"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot" />
                    <SeekBar
                        android:id="@+id/seekbar_float_bass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="100"
                        android:progress="60" />
                    <TextView
                        android:id="@+id/tv_float_bass_val"
                        android:layout_width="38dp"
                        android:layout_height="wrap_content"
                        android:text="60%"
                        android:textColor="@color/nothing_white"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot"
                        android:gravity="end" />
                </LinearLayout>

                <!-- 3D Surround -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="3D SURR"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot" />
                    <SeekBar
                        android:id="@+id/seekbar_float_virtualizer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="100"
                        android:progress="50" />
                    <TextView
                        android:id="@+id/tv_float_virtualizer_val"
                        android:layout_width="38dp"
                        android:layout_height="wrap_content"
                        android:text="50%"
                        android:textColor="@color/nothing_white"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Preamp -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:text="PREAMP"
                        android:textColor="@color/nothing_white_70"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot" />
                    <SeekBar
                        android:id="@+id/seekbar_float_preamp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/nothing_red"
                        android:thumbTint="@color/nothing_white"
                        android:max="24"
                        android:progress="12" />
                    <TextView
                        android:id="@+id/tv_float_preamp_val"
                        android:layout_width="38dp"
                        android:layout_height="wrap_content"
                        android:text="0 dB"
                        android:textColor="@color/nothing_white"
                        android:textSize="9sp"
                        android:fontFamily="@font/ndot"
                        android:gravity="end" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Minimized Pill View -->
    <LinearLayout
        android:id="@+id/eq_minimized_pill"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/led_red"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_minimized_eq_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EQ: ACTIVE"
            android:textColor="@color/nothing_white"
            android:textSize="9sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_expand_float_eq"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_expand"
            app:tint="@color/nothing_white_70"
            android:contentDescription="Expand"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/btn_close_minimized_eq"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_dotmatrix"
            app:tint="@color/nothing_white"
            android:contentDescription="Close" />
    </LinearLayout>

</LinearLayout>

