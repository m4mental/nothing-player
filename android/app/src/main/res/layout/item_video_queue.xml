<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/queue_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="6dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_nothing"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.cardview.widget.CardView
        android:layout_width="72dp"
        android:layout_height="44dp"
        app:cardCornerRadius="6dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/queue_item_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_video" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/queue_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video Title"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/queue_item_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● PLAYING"
                android:textColor="#D71921"
                android:textSize="9sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/queue_item_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/ndot" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
