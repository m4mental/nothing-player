<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_nothing"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="IN-VIDEO DIALOGUE SEARCH"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/ndot"
            android:letterSpacing="0.05" />

        <ImageButton
            android:id="@+id/btn_close_dialogue_search"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_close_dotmatrix"
            android:contentDescription="Close"
            app:tint="@color/nothing_white" />
    </RelativeLayout>

    <!-- Search Input -->
    <EditText
        android:id="@+id/et_search_dialogue_query"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_chip_dark_inactive"
        android:hint="Type a word to jump to dialogue..."
        android:textColorHint="#66FFFFFF"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:fontFamily="@font/ndot"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- Results Status Tag -->
    <TextView
        android:id="@+id/tv_dialogue_search_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MATCHING TIMESTAMPS"
        android:textColor="#D71921"
        android:textSize="8.5sp"
        android:fontFamily="@font/ndot"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Results List -->
    <ListView
        android:id="@+id/lv_dialogue_results"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:divider="#1AFFFFFF"
        android:dividerHeight="1dp"
        android:scrollbars="vertical" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_dialogue_empty"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="No matching dialogue found in subtitles"
        android:textColor="#66FFFFFF"
        android:textSize="9.5sp"
        android:fontFamily="@font/ndot"
        android:visibility="gone" />

</LinearLayout>