<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_nothing"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_margin="16dp"
    android:minWidth="320dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/led_red"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SUBTITLE DELAY / SYNC TUNER"
            android:textColor="#D71921"
            android:textSize="9sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TUNE TIMING IN REAL-TIME TO SYNC AUDIO WITH DIALOGUE"
        android:textColor="@color/nothing_white_40"
        android:textSize="7sp"
        android:fontFamily="@font/ndot"
        android:layout_marginBottom="16dp" />

    <!-- Big Center Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_chip_unselected"
        android:gravity="center"
        android:layout_marginBottom="18dp">

        <TextView
            android:id="@+id/tv_sub_delay_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 S"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <!-- Stepper Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="18dp">

        <Button
            android:id="@+id/btn_sub_delay_minus_500"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:text="-0.5S"
            android:textColor="@color/nothing_white"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btn_sub_delay_minus_100"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:text="-0.1S"
            android:textColor="@color/nothing_white"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:layout_marginHorizontal="2dp" />

        <Button
            android:id="@+id/btn_sub_delay_reset"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_chip_selected"
            android:text="RESET"
            android:textColor="@color/nothing_black"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:layout_marginHorizontal="2dp" />

        <Button
            android:id="@+id/btn_sub_delay_plus_100"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:text="+0.1S"
            android:textColor="@color/nothing_white"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:layout_marginHorizontal="2dp" />

        <Button
            android:id="@+id/btn_sub_delay_plus_500"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:text="+0.5S"
            android:textColor="@color/nothing_white"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:layout_marginStart="3dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginBottom="14dp" />

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_sub_delay_done"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_chip_red_active"
            android:text="APPLY &amp; CLOSE"
            android:textColor="#FFFFFF"
            android:textSize="8.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="20dp" />
    </LinearLayout>

</LinearLayout>
