<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nothing_black">

    <!-- ViewPager2 for Videos, Music -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@id/mini_player_container" />

    <!-- Persistent Bottom Mini Player -->
    <RelativeLayout
        android:id="@+id/mini_player_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_above="@id/bottom_nav"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_mini_player"
        android:visibility="gone">

        <!-- Thin Progress Indicator -->
        <ProgressBar
            android:id="@+id/mini_player_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_alignParentTop="true"
            android:progressTint="@color/nothing_red"
            android:progress="0"
            android:max="100" />

        <ImageView
            android:id="@+id/mini_player_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:scaleType="centerCrop"
            android:background="@color/nothing_surface"
            android:src="@android:drawable/ic_media_play" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/mini_player_art"
            android:layout_toStartOf="@id/mini_player_controls"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track Title"
                android:textColor="@color/nothing_white"
                android:textSize="10.5sp"
                android:fontFamily="@font/ndot"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/mini_player_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Artist"
                android:textColor="@color/nothing_white_40"
                android:textSize="8.5sp"
                android:fontFamily="@font/ndot"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mini_player_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/mini_player_btn_play"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_play_dotmatrix"
                android:contentDescription="Play/Pause"
                app:tint="@color/nothing_white" />

            <ImageButton
                android:id="@+id/mini_player_btn_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_next_dotmatrix"
                android:contentDescription="Next"
                app:tint="@color/nothing_white" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@color/nothing_black"
        app:itemTextColor="@color/nav_item_color"
        app:itemIconTint="@color/nav_item_color"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</RelativeLayout>
