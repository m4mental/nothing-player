<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_nothing"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_margin="16dp"
    android:minWidth="340dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/led_red"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TRANSLATE &amp; REPLACE SUBTITLE (OFFLINE ML)"
            android:textColor="#D71921"
            android:textSize="9.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Source Info Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#161616"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_source_subtitle_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SOURCE: ENGLISH (1,240 DIALOGUES LOADED)"
            android:textColor="#B0B0B0"
            android:textSize="8sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_model_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● OFFLINE READY"
            android:textColor="#D71921"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Target Language Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELECT TARGET LANGUAGE:"
        android:textColor="#FFFFFF"
        android:textSize="8.5sp"
        android:fontFamily="@font/ndot"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="8dp" />

    <!-- Target Language Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/layout_language_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Mode Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REPLACEMENT &amp; PLAYBACK MODE:"
        android:textColor="#FFFFFF"
        android:textSize="8.5sp"
        android:fontFamily="@font/ndot"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="8dp" />

    <!-- Mode Selector Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <Button
            android:id="@+id/btn_mode_replace"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_red_active"
            android:text="● REPLACE ORIGINAL"
            android:textColor="#FFFFFF"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_mode_dual"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:text="○ DUAL (ENG + HIN)"
            android:textColor="#88FFFFFF"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live Translation Progress Container (Shown during translation) -->
    <LinearLayout
        android:id="@+id/layout_translation_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161616"
        android:padding="10dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_progress_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● TRANSLATING DIALOGUES... [0 / 0] (0%)"
            android:textColor="#D71921"
            android:textSize="8sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ProgressBar
            android:id="@+id/pb_translation"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#D71921"
            android:progressBackgroundTint="#26FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Live Ticker Preview -->
        <TextView
            android:id="@+id/tv_live_source_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ORIGINAL: ..."
            android:textColor="#77FFFFFF"
            android:textSize="7.5sp"
            android:fontFamily="@font/ndot"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_live_translated_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRANSLATED: ..."
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btn_trans_cancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_unselected"
            android:text="CANCEL"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_trans_start"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_red_active"
            android:text="⚡ TRANSLATE &amp; ATTACH"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:fontFamily="@font/ndot"
            android:textStyle="bold"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

</LinearLayout>

